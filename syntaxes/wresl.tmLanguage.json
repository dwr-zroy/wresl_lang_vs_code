{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WRESL",
  "scopeName": "source.wresl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.wresl",
      "patterns": [
        {
          "name": "comment.line.exclamation.wresl",
          "begin": "!",
          "end": "\\n"
        },
        {
          "name": "comment.line.slash.wresl",
          "begin": "//",
          "end": "\\n"
        },
        {
          "name": "comment.block.wresl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wresl",
          "begin": "\\"",
          "end": "\\""
        },
        {
          "name": "string.quoted.single.wresl",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?i)\\b(model|sequence|order|include|group|initial|goal|objective|weight|define|dvar|svar|value|external|timeseries|timestep|alias|integer|std|kind|units|convert|nosolver|case|condition|if|elseif|else|select|given|use|where|from|sum|penalty|variable|linear|maximum|minimum|unbounded|constrain|upper|lower|lhs|rhs)\\b",
          "name": "keyword.control.wresl"
        },
        {
          "match": "(?i)\\b(local|global)\\b",
          "name": "storage.modifier.wresl"
        },
        {
          "match": "(?i)\\b(always|daysin|month|wateryear|prevjan|prevfeb|prevmar|prevapr|prevmay|prevjun|prevjul|prevaug|prevsep|prevoct|prevnov|prevdec|jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec|1mon|1day)\\b",
          "name": "constant.language.wresl"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(model|sequence|group|goal|objective|define|dvar|svar|timeseries|alias)\\b\\s+([A-Z][A-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.wresl" },
            "2": { "name": "entity.name.type.wresl" }
          }
        },
        {
          "match": "(?i)\\b(select)\\b\\s+([A-Z][A-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.wresl" },
            "2": { "name": "entity.name.type.wresl" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?i)(\\.and\\.|\\.or\\.|\\.not\\.|\\.ne\\.|==|>=|<=|=|>|<)",
          "name": "keyword.operator.wresl"
        },
        {
          "match": "[+\\-*/:]",
          "name": "keyword.operator.arithmetic.wresl"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "(?i)\\b(abs|int|real|exp|log|log10|sqrt|round|pow|mod|min|max|range)\\b",
          "name": "support.function.wresl"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?i)\\$m",
          "name": "constant.language.futurearray.wresl"
        },
        {
          "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?![A-Za-z0-9_])",
          "name": "constant.numeric.wresl"
        },
        {
          "match": "(?i)\\b(unbounded)\\b",
          "name": "constant.language.bounds.wresl"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])([A-Z][A-Z0-9_]*)(?![A-Za-z0-9_])",
          "name": "entity.name.type.wresl"
        },
        {
          "match": "(?<![A-Za-z0-9_])([A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_])",
          "name": "variable.other.wresl"
        }
      ]
    }
  }
}
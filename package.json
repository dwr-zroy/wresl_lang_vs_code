{
	"author": "ZRoy @ CA Department of Water Resources, State Water Project Modeling Support Office",
	"publisher": "dwr-zroy",
  "name": "wresl-highlight",
  "repository": {
    "type": "github",
    "url": "https://github.com/dwr-zroy/wresl_lang_vs_code"
  },
  "displayName": "WRESL+ Highlighting",
  "description": "Water Resources Simultion Language Syntax Highlighting",
  "version": "1.2.1",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "contributes": {
    "languages": [{
      "id": "wresl",
      "aliases": ["WRESL", "WRESL+", "WRESL Plus"],
      "extensions": [".wresl" ,".wpp"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "wresl",
      "scopeName": "source.wresl",
      "path": "./syntaxes/wresl.tmLanguage.json"
    }],
    "themes": [
      {
        "label": "WRESL-Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/wresl_dark.json"
      },
      {
        "label": "wresl",
        "uiTheme": "vs",
        "path": "./themes/wresl_light.json"
      }
    ],
    "snippets": [
      {
        "language": "wresl",
        "path": "./snippets/wresl.json"
      }
    ]
  }
}
